// TechWave Retail360 - SQLite Database Schema (Backup)
// Fully relational, PostgreSQL/Supabase compatible architecture

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  role          String    @default("CUSTOMER") // "CUSTOMER" | "ADMIN"
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       Profile?
  orders        Order[]
  addresses     Address[]
  reviews       Review[]
  inquiries     Inquiry[]
  cart          Cart?
  wishlist      Wishlist?
  notifications Notification[]
  aiConversations AiConversation[]

  @@index([email])
  @@index([role])
}

model Profile {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarUrl        String?
  bio              String?
  defaultAddressId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  status      String    @default("ACTIVE") // "ACTIVE" | "INACTIVE"
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@index([slug])
  @@index([status])
}

model Product {
  id                 String              @id @default(uuid())
  name               String
  slug               String              @unique
  description        String
  shortDescription   String?
  categoryId         String
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  price              Float
  discountPrice      Float?
  sku                String              @unique
  stock              Int                 @default(0)
  lowStockThreshold  Int                 @default(5)
  status             String              @default("ACTIVE") // "ACTIVE" | "INACTIVE" | "DRAFT"
  isFeatured         Boolean             @default(false)
  isBestseller       Boolean             @default(false)
  tags               String?             // comma-separated tags
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  images             ProductImage[]
  attributes         ProductAttribute[]
  inventory          Inventory?
  inventoryLogs      InventoryTransaction[]
  orderItems         OrderItem[]
  cartItems          CartItem[]
  wishlistItems      WishlistItem[]
  reviews            Review[]
  inquiries          Inquiry[]

  @@index([slug])
  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([isBestseller])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductAttribute {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String   // e.g. "Fabric", "Color", "Occasion", "Pattern", "Blouse Piece", "Care"
  value     String   // e.g. "Pure Kanjivaram Silk", "Deep Crimson", "Bridal / Festive"
  createdAt DateTime @default(now())

  @@index([productId])
}

model Inventory {
  id             String   @id @default(uuid())
  productId      String   @unique
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  currentStock   Int      @default(0)
  reservedStock  Int      @default(0)
  lowStockAlert  Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

model InventoryTransaction {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type           String   // "ORDER_DEDUCT" | "RESTOCK" | "ADJUSTMENT" | "ORDER_CANCEL_RESTORE"
  quantityChange Int      // positive or negative
  previousStock  Int
  newStock       Int
  referenceId    String?  // e.g. orderId or admin note
  notes          String?
  createdAt      DateTime @default(now())

  @@index([productId])
  @@index([type])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items     CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  price     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model Order {
  id                String       @id @default(uuid())
  orderNumber       String       @unique // e.g. "TW-2026-00101"
  userId            String?
  user              User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName      String
  customerEmail     String
  customerPhone     String
  shippingAddress   String
  city              String
  state             String
  pinCode           String
  country           String       @default("India")
  subtotal          Float
  discount          Float        @default(0)
  shippingFee       Float        @default(0)
  tax               Float        @default(0)
  total             Float
  status            String       @default("PENDING") // PENDING, CONFIRMED, PROCESSING, PACKED, SHIPPED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  paymentStatus     String       @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  paymentMethod     String       @default("RAZORPAY")
  razorpayOrderId   String?
  razorpayPaymentId String?
  trackingNumber    String?
  carrier           String?      @default("Express Courier")
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  items             OrderItem[]
  payments          Payment[]

  @@index([orderNumber])
  @@index([userId])
  @@index([customerEmail])
  @@index([customerPhone])
  @@index([status])
  @@index([paymentStatus])
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  productName    String
  productSku     String
  productImage   String?
  unitPrice      Float
  quantity       Int
  total          Float
  attributesJson String?  // Snapshot of attributes
  createdAt      DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id               String   @id @default(uuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentGateway   String   @default("RAZORPAY")
  gatewayOrderId   String?
  gatewayPaymentId String?
  gatewaySignature String?
  amount           Float
  currency         String   @default("INR")
  status           String   @default("PENDING") // PENDING, SUCCESS, FAILED, REFUNDED
  rawResponse      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orderId])
  @@index([gatewayOrderId])
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  phone         String
  streetAddress String
  city          String
  state         String
  pinCode       String
  country       String   @default("India")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  items     WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@index([productId])
}

model Review {
  id                 String   @id @default(uuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName           String
  rating             Int      @default(5)
  comment            String
  isVerifiedPurchase Boolean  @default(true)
  status             String   @default("APPROVED") // APPROVED, PENDING
  createdAt          DateTime @default(now())

  @@index([productId])
  @@index([status])
}

model Inquiry {
  id          String   @id @default(uuid())
  name        String
  email       String
  phone       String?
  message     String
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  inquiryType String   @default("GENERAL") // GENERAL, PRODUCT, ORDER, CUSTOM_ORDER
  status      String   @default("NEW")     // NEW, IN_PROGRESS, RESOLVED
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([email])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("ORDER") // ORDER, PAYMENT, INVENTORY, SYSTEM
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model AiConversation {
  id        String      @id @default(uuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String?
  role      String      @default("CUSTOMER") // "CUSTOMER" | "ADMIN"
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  messages  AiMessage[]

  @@index([userId])
  @@index([sessionId])
  @@index([role])
}

model AiMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String         // "USER" | "ASSISTANT" | "SYSTEM"
  content        String
  metadataJson   String?        // Any structured data (e.g., matched product IDs or analytics cards)
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}
