PORT=5000
CLIENT_URL="http://localhost:3000"

# Database Configuration (Supabase PostgreSQL / SQLite)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Supabase API Credentials
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# JWT Secret for Session Authentication
JWT_SECRET="techwave-retail360-jwt-secret-replace-in-production"

# Razorpay Payment Gateway (Test / Live Mode)
RAZORPAY_KEY_ID="rzp_test_placeholder_id"
RAZORPAY_KEY_SECRET="placeholder_secret_key"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# AI Assistant Engine (Rule-based or LLM)
AI_API_KEY="your-ai-api-key"
AI_PROVIDER="rule_based"

# WhatsApp Business Communication
WHATSAPP_PHONE="+919641145871"

# SMS Gateway for Phone OTP delivery to physical mobile phones
# Option A: Fast2SMS (Recommended for India, instant setup without DLT)
FAST2SMS_API_KEY="your-fast2sms-api-key"
# Option B: Twilio (International)
TWILIO_ACCOUNT_SID="your-twilio-sid"
TWILIO_AUTH_TOKEN="your-twilio-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Email Gateway for Password Reset & In-App Email Notifications
# Option A: Resend (Recommended, fast modern API)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Royal Saree & Fashion <onboarding@resend.dev>"
# Option B: Gmail SMTP (Free with any Google account using App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-store-email@gmail.com"
SMTP_PASS="your-16-digit-gmail-app-password"
